[header]
type = "tuisana"
version = 1.0

[auth]
# Create a personal access token in Asana's developer console.
personal_access_token = "your-asana-pat-here"
# Optional. Leave this out if you want to list projects without narrowing to a workspace.
# The "No Project (Assigned to Me)" row appears automatically once tuisana can resolve your
# logged-in user; this field is only needed to load its tasks after you select it. Only tasks
# outside every project stay under the row's name. Ones that do live in a project — for a subtask,
# the project of the nearest parent that has one — are grouped under it, and shown only when that
# project is selected too.
workspace_gid = "your-workspace-gid-here"

# Appearance. Every value is optional; these are the defaults.
[theme]
# "ansi" uses the terminal's own 16 colors, "truecolor" adds indexed shades,
# "mono" drops color entirely. Setting NO_COLOR forces "mono".
variant = "ansi"
# "ascii" swaps every box-drawing and marker glyph for an ASCII equivalent.
glyphs = "unicode"
# black, red, green, yellow, blue, magenta, cyan, white, gray
accent = "cyan"
# Stripe alternating task rows. Requires variant = "truecolor".
zebra = false

# Projects not listed here default to hidden.

[[bind]]
key = "?"
command = "toggle_help_details"

[[bind]]
key = "q"
command = "quit"

[[bind]]
key = "ctrl-c"
command = "quit"

[[bind]]
key = "k"
command = "move_up"

[[bind]]
key = "j"
command = "move_down"

[[bind]]
key = "ctrl-u"
command = "page_up"

[[bind]]
key = "ctrl-d"
command = "page_down"

[[bind]]
key = "home"
command = "jump_top"

[[bind]]
key = "end"
command = "jump_bottom"

[[bind]]
key = "left"
command = "scroll_left"

[[bind]]
key = "right"
command = "scroll_right"

[[bind]]
key = "f"
command = "set_filter_mode"

[[bind]]
key = "p"
command = "set_project_mode"

[[bind]]
key = "t"
command = "toggle_task_view"

[[bind]]
key = "m"
command = "toggle_task_mode"

[[bind]]
key = "["
command = "resize_top_pane_down"

[[bind]]
key = "]"
command = "resize_top_pane_up"

[[bind]]
key = "{"
command = "minimize_top_pane"

[[bind]]
key = "}"
command = "maximize_top_pane"

[[bind]]
key = "0"
command = "restore_top_pane"

[[bind]]
key = "enter"
mode = "project"
command = "open"

[[bind]]
key = "r"
command = "refresh"

[[bind]]
key = "/"
mode = "project"
command = "start_search"

[[bind]]
key = "ctrl-l"
mode = "project_search"
command = "clear_search"

[[bind]]
key = "space"
mode = "project"
command = "toggle_selection"

[[bind]]
key = "a"
mode = "project"
command = "select_all_visible"

[[bind]]
key = "!"
mode = "project"
command = "select_all_starred_visible"

[[bind]]
key = "@"
mode = "project"
command = "select_all_non_hidden_visible"

[[bind]]
key = "i"
mode = "project"
command = "invert_selection"

[[bind]]
key = "c"
mode = "project"
command = "clear_selection"

[[bind]]
key = "u"
mode = "project"
command = "undo_selection"

[[bind]]
key = "ctrl-y"
mode = "project"
command = "redo_selection"

[[bind]]
key = "*"
mode = "project"
command = "toggle_starred_selected"

[[bind]]
key = "h"
mode = "project"
command = "toggle_hidden_selected"

[[bind]]
key = "v"
mode = "project"
command = "toggle_hidden_group"

[[bind]]
key = "o"
mode = "project"
command = "toggle_only_selected"

[[bind]]
key = "ctrl-f"
mode = "project"
command = "search_fuzzy"

[[bind]]
key = "ctrl-s"
mode = "project"
command = "search_substring"

[[bind]]
key = "ctrl-r"
mode = "project"
command = "search_regex"

[[bind]]
key = "enter"
mode = "filter"
command = "begin_filter_edit"

[[bind]]
key = "f"
mode = "filter"
command = "toggle_task_filters"

[[bind]]
key = "s"
mode = "filter"
command = "cycle_filter_string_mode"

# The filter panel holds one or more sets, ORed together: fields narrow within a
# set, results combine between sets. `a` adds a set after the current one, `x`
# removes it (refused at one set), and h/l move between them.

[[bind]]
key = "a"
mode = "filter"
command = "filter_set_add"

[[bind]]
key = "x"
mode = "filter"
command = "filter_set_remove"

[[bind]]
key = "l"
mode = "filter"
command = "filter_set_next"

[[bind]]
key = "h"
mode = "filter"
command = "filter_set_prev"

# "Has no value" is a filter of its own, since an empty field means "do not
# filter". Letters type while editing, so it needs a ctrl- pair in filter-edit
# mode; in calendar mode ctrl-e already jumps to the end of a range, which is
# why a date field's require-empty is set from browse mode, before the picker
# opens. It used to be ctrl-e in filter-edit mode too; that key is now
# "end of line", which is what it means everywhere else text is edited.

[[bind]]
key = "e"
mode = "filter"
command = "filter_require_empty"

[[bind]]
key = "ctrl-q"
mode = "filter_edit"
command = "filter_require_empty"

# Negation. `!` inverts the selected field — it now keeps what it was throwing
# away, so `!` on a require-empty reads "has some value". `~` inverts the whole
# active set, after its fields have ANDed: `not (a and b)`, which is a
# different statement from negating each row. Both are ordinary characters in a
# query, so filter-edit mode gets ctrl- pairs.

[[bind]]
key = "!"
mode = "filter"
command = "filter_negate_field"

[[bind]]
key = "~"
mode = "filter"
command = "filter_negate_set"

[[bind]]
key = "ctrl-n"
mode = "filter_edit"
command = "filter_negate_field"

[[bind]]
key = "ctrl-t"
mode = "filter_edit"
command = "filter_negate_set"

# Named filter sets. `b` shows the `Sets` sidebar, `1`-`9` load the entry at
# that position in its visible window, and `<`/`>` page the window when there
# are more entries than fit. `w` saves the panel under a name and binds to it:
# from then on every edit writes through to that entry. `y` copies the panel
# to a new unnamed one, keeping what is on screen; `n` throws it away and
# starts from nothing; `d` deletes the loaded entry after a confirmation.
#
# The input layer lowercases letters, so a shifted *letter* is unreachable —
# but shifted punctuation arrives as its own character, which is what makes
# `<` and `>` available here. `0` is left alone: it restores the top pane.

[[bind]]
key = "b"
mode = "filter"
command = "filter_sets_toggle"

[[bind]]
key = "w"
mode = "filter"
command = "filter_set_save"

[[bind]]
key = "y"
mode = "filter"
command = "filter_set_copy_to_new"

[[bind]]
key = "n"
mode = "filter"
command = "filter_set_new"

[[bind]]
key = "d"
mode = "filter"
command = "filter_set_delete"

[[bind]]
key = "<"
mode = "filter"
command = "filter_sets_page_back"

[[bind]]
key = ">"
mode = "filter"
command = "filter_sets_page_forward"

# All nine spelled out, so any of them can be rebound on its own.

[[bind]]
key = "1"
mode = "filter"
command = "filter_set_load_1"

[[bind]]
key = "2"
mode = "filter"
command = "filter_set_load_2"

[[bind]]
key = "3"
mode = "filter"
command = "filter_set_load_3"

[[bind]]
key = "4"
mode = "filter"
command = "filter_set_load_4"

[[bind]]
key = "5"
mode = "filter"
command = "filter_set_load_5"

[[bind]]
key = "6"
mode = "filter"
command = "filter_set_load_6"

[[bind]]
key = "7"
mode = "filter"
command = "filter_set_load_7"

[[bind]]
key = "8"
mode = "filter"
command = "filter_set_load_8"

[[bind]]
key = "9"
mode = "filter"
command = "filter_set_load_9"

[[bind]]
key = "["
mode = "task"
command = "move_section_up"

[[bind]]
key = "]"
mode = "task"
command = "move_section_down"

[[bind]]
key = "{"
mode = "task"
command = "move_project_up"

[[bind]]
key = "}"
mode = "task"
command = "move_project_down"

[[bind]]
key = "c"
mode = "task"
command = "toggle_completed_filter"

[[bind]]
key = "z"
mode = "task"
command = "toggle_subtask_visibility"

[[bind]]
key = ","
mode = "task"
command = "toggle_project_grouping"

[[bind]]
key = "."
mode = "task"
command = "toggle_section_grouping"

[[bind]]
key = "s"
mode = "task"
command = "cycle_task_sort"

[[bind]]
key = "^"
mode = "task"
command = "toggle_task_sort_direction"

# The column cursor and the cell editor. h, l, e, and d are all free in task
# mode, and the global fallback binds none of them.

[[bind]]
key = "h"
mode = "task"
command = "task_column_prev"

[[bind]]
key = "l"
mode = "task"
command = "task_column_next"

[[bind]]
key = "e"
mode = "task"
command = "begin_task_edit"

[[bind]]
key = "d"
mode = "task"
command = "toggle_task_completed"

# The recently-edited pane, between the project list and the table: the tasks
# an edit has pushed out of the current filter. Same letter the filter pane
# uses for its sidebar — both are "show me the panel beside this one".

[[bind]]
key = "b"
mode = "task"
command = "toggle_recent_pane"

# "task_edit" mode is a cell open for editing. Like filter-edit and calendar
# mode it does not fall back to the global bindings, so an unbound letter
# types into the cell rather than firing the command that letter carries.
#
# j, k, and d are context-sensitive: they step a value picker on a State or
# enum cell, and type their own character on a cell that holds text. ctrl-l
# clears whatever the editor holds either way.

[[bind]]
key = "enter"
mode = "task_edit"
command = "commit_task_edit"

[[bind]]
key = "esc"
mode = "task_edit"
command = "cancel_task_edit"

[[bind]]
key = "j"
mode = "task_edit"
command = "task_edit_next_value"

[[bind]]
key = "k"
mode = "task_edit"
command = "task_edit_prev_value"

[[bind]]
key = "d"
mode = "task_edit"
command = "task_edit_clear"

[[bind]]
key = "ctrl-l"
mode = "task_edit"
command = "task_edit_clear"

# Completion, on the two cells whose values are names the backend knows:
# Assignee and Projects. tab walks the candidates with the typed prefix
# intact, so a wrong first match costs one more keystroke rather than an undo.

[[bind]]
key = "tab"
mode = "task_edit"
command = "complete_next_candidate"

[[bind]]
key = "shift-tab"
mode = "task_edit"
command = "complete_prev_candidate"

# The emacs motions, shared by every field that takes text. `alt-` needs the
# terminal to send Option as a modifier rather than as an escape prefix; see
# the README. Rebind them if yours cannot.

[[bind]]
key = "left"
mode = "task_edit"
command = "filter_caret_left"

[[bind]]
key = "right"
mode = "task_edit"
command = "filter_caret_right"

[[bind]]
key = "ctrl-b"
mode = "task_edit"
command = "filter_caret_left"

[[bind]]
key = "ctrl-f"
mode = "task_edit"
command = "filter_caret_right"

[[bind]]
key = "alt-b"
mode = "task_edit"
command = "text_caret_word_back"

[[bind]]
key = "alt-f"
mode = "task_edit"
command = "text_caret_word_forward"

[[bind]]
key = "ctrl-a"
mode = "task_edit"
command = "text_caret_start"

[[bind]]
key = "ctrl-e"
mode = "task_edit"
command = "text_caret_end"

# The Assignee filter row has a fourth match mode, "list": its values are
# picked from the workspace directory rather than typed as a pattern. These
# are the same two keys the cell editor completes with.

[[bind]]
key = "tab"
mode = "filter_edit"
command = "complete_next_candidate"

[[bind]]
key = "shift-tab"
mode = "filter_edit"
command = "complete_prev_candidate"

[[bind]]
key = "alt-b"
mode = "filter_edit"
command = "text_caret_word_back"

[[bind]]
key = "alt-f"
mode = "filter_edit"
command = "text_caret_word_forward"

[[bind]]
key = "ctrl-a"
mode = "filter_edit"
command = "text_caret_start"

[[bind]]
key = "ctrl-e"
mode = "filter_edit"
command = "text_caret_end"

# Pressing enter on the Due or Start filter opens a calendar overlay. These are
# its keys; "calendar" mode does not fall back to global bindings, so digits and
# other unbound keys type into the date instead.
[[bind]]
key = "h"
mode = "calendar"
command = "calendar_prev_day"

[[bind]]
key = "l"
mode = "calendar"
command = "calendar_next_day"

[[bind]]
key = "k"
mode = "calendar"
command = "calendar_prev_month"

[[bind]]
key = "j"
mode = "calendar"
command = "calendar_next_month"

[[bind]]
key = "t"
mode = "calendar"
command = "calendar_today"

# `filter_caret_*` works on any filter field, not just dates, and is bound to both
# the arrows and ctrl-b/ctrl-f in filter-edit and calendar modes. That is why
# search_fuzzy defaults to ctrl-z rather than ctrl-f. ctrl-a and ctrl-e jump
# between the two ends of a `start..end` range, and do nothing without one.
[[bind]]
key = "ctrl-b"
mode = "calendar"
command = "filter_caret_left"

[[bind]]
key = "ctrl-f"
mode = "calendar"
command = "filter_caret_right"

[[bind]]
key = "ctrl-a"
mode = "calendar"
command = "calendar_jump_to_start"

[[bind]]
key = "ctrl-e"
mode = "calendar"
command = "calendar_jump_to_end"

[[project]]
gid = "project-gid-here"
starred = true
hidden = false

# Filter panels saved under a name. Normally written by the app — `w` in the
# filter panel, and then every edit while the entry is loaded — but writable
# by hand and read back exactly as written. Anything at its default is left
# out, which is why this one names no match mode and no negation.
#
# `key` is the panel's own row key: title, assignee, due, start, state,
# projects, or custom:<Name>. Custom fields are keyed by name so an entry
# survives a reload that brings different Asana ids, and a key matching no
# loaded row is kept rather than dropped.

[[filter_set]]
name = "Overdue mine"

  [[filter_set.set]]

    [[filter_set.set.field]]
    key = "assignee"
    query = "alex"

    [[filter_set.set.field]]
    key = "due"
    query = "..today"
