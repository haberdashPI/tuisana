[header]
type = "tuisana"
version = 1.0

[auth]
# Create a personal access token in Asana's developer console.
personal_access_token = "your-asana-pat-here"
# Optional. Leave this out if you want to list projects without narrowing to a workspace.
workspace_gid = "your-workspace-gid-here"

[[bind]]
key = "?"
command = "toggle_help_details"

[[bind]]
key = "q"
command = "quit"

[[bind]]
key = "ctrl-c"
command = "quit"

[[bind]]
key = "k"
command = "move_up"

[[bind]]
key = "j"
command = "move_down"

[[bind]]
key = "enter"
command = "open"

[[bind]]
key = "r"
command = "refresh"

[[bind]]
key = "/"
command = "start_search"

[[bind]]
key = "ctrl-l"
command = "clear_search"

[[bind]]
key = "space"
command = "toggle_selection"

[[bind]]
key = "a"
command = "select_all_visible"

[[bind]]
key = "i"
command = "invert_selection"

[[bind]]
key = "c"
command = "clear_selection"

[[bind]]
key = "u"
command = "undo_selection"

[[bind]]
key = "ctrl-y"
command = "redo_selection"

[[bind]]
key = "home"
command = "jump_top"

[[bind]]
key = "end"
command = "jump_bottom"

[[bind]]
key = "*"
command = "toggle_starred_selected"

[[bind]]
key = "h"
command = "toggle_hidden_selected"

[[bind]]
key = "v"
command = "toggle_hidden_group"

[[bind]]
key = "t"
command = "toggle_task_view"

[[bind]]
key = "m"
command = "toggle_task_mode"

[[bind]]
key = "o"
command = "toggle_only_selected"

[[bind]]
key = "ctrl-f"
command = "search_fuzzy"

[[bind]]
key = "ctrl-s"
command = "search_substring"

[[bind]]
key = "ctrl-r"
command = "search_regex"

[[bind]]
key = "ctrl-u"
command = "page_up"

[[bind]]
key = "ctrl-d"
command = "page_down"

[[bind]]
key = "c"
command = "toggle_completed_filter"

[[bind]]
key = "z"
command = "toggle_subtask_visibility"

[[bind]]
key = "p"
command = "toggle_project_grouping"

[[bind]]
key = "g"
command = "toggle_section_grouping"

[[bind]]
key = "s"
command = "cycle_task_sort"

[[project]]
gid = "project-gid-here"
starred = true
hidden = false

[[project]]
gid = "another-project-gid-here"
starred = false
hidden = true
